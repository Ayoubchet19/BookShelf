<?xml version="1.0" encoding="utf-8"?>
<!-- One category row in StatisticsActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="6dp">
    <TextView android:id="@+id/category_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold"/>
    <TextView android:id="@+id/category_details" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
