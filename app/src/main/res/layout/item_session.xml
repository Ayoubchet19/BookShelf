<?xml version="1.0" encoding="utf-8"?>
<!-- One reading session row in BookDetailActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingVertical="6dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/session_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold"/>
        <TextView android:id="@+id/session_details" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
    <Button android:id="@+id/edit_session_button" style="?attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/session_edit"/>
    <Button android:id="@+id/delete_session_button" style="?attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/session_delete"/>
</LinearLayout>
